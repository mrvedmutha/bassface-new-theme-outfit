{%- comment -%}
  Bassface site footer.

  One section, two variants. The design's "minimal" footer is exactly the full
  footer's top rule plus its link row, so this renders the same block either way
  and simply omits the masthead, intro and mid rule when minimal.

  Variant selection is driven by `template` rather than by the section group.
  Dawn renders a single {% sections 'footer-group' %} for the entire store, so
  there is no per-template group to wire this into. The audited mapping is:

    full     index, product, collection, list-collections, search, page
    minimal  cart and the legal pages
    none     404

  Legal pages are ordinary Pages, not Shopify's /policies/* URLs — Shopify has no
  policy template type, so those pages cannot carry this design. They are matched
  by template suffix (page.legal) so a merchant can opt any page in.
{%- endcomment -%}

{{ 'bf-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign variant = section.settings.variant

  if variant == 'auto'
    case template.name
      when '404'
        assign variant = 'none'
      when 'cart'
        assign variant = 'minimal'
      when 'page'
        if template.suffix == 'legal'
          assign variant = 'minimal'
        else
          assign variant = 'full'
        endif
      else
        assign variant = 'full'
    endcase
  endif

  assign year_full = 'now' | date: '%Y'
  assign year_short = 'now' | date: '%y'

  assign newsletter_id = 'ColophonNewsletter-' | append: section.id
  assign has_newsletter = false
  if section.settings.newsletter_enabled
    assign has_newsletter = true
  endif
-%}

{%- unless variant == 'none' -%}
  <footer class="colophon colophon--{{ variant }}">
    <div class="colophon__inner">
      <hr class="colophon__rule colophon__rule--top">

      {%- if variant == 'full' -%}
        <div class="colophon__masthead">
          <div>
            {%- if section.settings.tagline_line_1 != blank -%}
              <p class="colophon__tagline">{{ section.settings.tagline_line_1 | escape }}</p>
            {%- endif -%}
            {%- if section.settings.tagline_line_2 != blank -%}
              <p class="colophon__tagline colophon__tagline--secondary">
                {{- section.settings.tagline_line_2 | escape -}}
              </p>
            {%- endif -%}
          </div>

          <div class="colophon__lockup">
            <span class="colophon__mark">
              {%- render 'bf-logo', shape: 'mark', width: '100%' -%}
            </span>
            <span class="colophon__numeral">{{ year_short }}</span>
          </div>
        </div>

        {%- if section.settings.intro != blank or has_newsletter -%}
          <div class="colophon__body">
            {%- if section.settings.intro != blank -%}
              <p class="colophon__intro">{{ section.settings.intro | escape }}</p>
            {%- endif -%}

            {%- comment -%}
              The signup posts to Shopify's own customer form, so there is no
              endpoint to configure and no JS: the browser submits, Shopify
              redirects back with ?customer_posted=true, and the success branch
              below renders. `contact[tags]` is what puts the subscriber in the
              "newsletter" segment, exactly as Dawn's own newsletter section does.
            {%- endcomment -%}
            {%- if has_newsletter -%}
              <div class="colophon__newsletter">
                {%- if section.settings.newsletter_label != blank -%}
                  <p class="colophon__label">{{ section.settings.newsletter_label | escape }}</p>
                {%- endif -%}

                {%- if section.settings.newsletter_copy != blank -%}
                  <p class="colophon__newsletter-copy">{{ section.settings.newsletter_copy | escape }}</p>
                {%- endif -%}

                {%- form 'customer', id: newsletter_id, class: 'colophon__form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <label class="visually-hidden" for="{{ newsletter_id }}-email">
                    {{- 'newsletter.label' | t -}}
                  </label>

                  <div class="colophon__field">
                    <input
                      id="{{ newsletter_id }}-email"
                      class="colophon__input"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      aria-required="true"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="{{ newsletter_id }}-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="{{ newsletter_id }}-success"
                      {% endif %}
                      required
                    >
                    <button
                      type="submit"
                      name="commit"
                      class="colophon__submit"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      {%- render 'bf-icon', icon: 'arrow-right', size: 18 -%}
                    </button>
                  </div>

                  {%- if form.errors -%}
                    <p class="colophon__message" id="{{ newsletter_id }}-error">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </p>
                  {%- elsif form.posted_successfully? -%}
                    <p class="colophon__message" id="{{ newsletter_id }}-success" tabindex="-1">
                      {{- 'newsletter.success' | t -}}
                    </p>
                  {%- endif -%}
                {%- endform -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <hr class="colophon__rule colophon__rule--mid">
      {%- endif -%}

      <div class="colophon__links">
        <div class="colophon__brand">
          <a href="{{ routes.root_url }}" class="colophon__link colophon__wordmark">
            {%- render 'bf-logo', shape: 'wordmark', width: '100%', label: shop.name -%}
          </a>
          <p class="colophon__text">{{ section.settings.copyright | escape }} © {{ year_full }}</p>
        </div>

        {%- if section.settings.address != blank -%}
          <div class="colophon__group colophon__group--address">
            {%- if section.settings.label_address != blank -%}
              <p class="colophon__label">{{ section.settings.label_address | escape }}</p>
            {%- endif -%}
            <address class="colophon__text colophon__address">{{ section.settings.address | escape }}</address>
          </div>
        {%- endif -%}

        {%- comment -%}
          The menus are unset until a merchant picks them — link_list settings
          cannot carry an arbitrary handle as a schema default, only `main-menu`
          or `footer`, and pointing the policy column at the wrong menu by
          default would be worse than leaving it empty. So every group is
          guarded, and each one carries its own label.

          The three menu columns share a wrapper because the design groups them:
          space-between distributes the four clusters (brand, address, links,
          payments) across the row, and without the wrapper it would spread the
          link columns apart individually instead. On the stacked layout the
          wrapper is display:contents so its columns rejoin the outer grid.
        {%- endcomment -%}
        <div class="colophon__cols">
          {%- assign policies = section.settings.menu_policies -%}
          {%- if policies != blank and policies.links.size > 0 -%}
            <div class="colophon__group colophon__group--policies">
              {%- if section.settings.label_policies != blank -%}
                <p class="colophon__label">{{ section.settings.label_policies | escape }}</p>
              {%- endif -%}
              <ul class="colophon__col">
                {%- for link in policies.links -%}
                  <li>
                    <a href="{{ link.url }}" class="colophon__link colophon__text">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- assign social = section.settings.menu_social -%}
          {%- if social != blank and social.links.size > 0 -%}
            <div class="colophon__group colophon__group--social">
              {%- if section.settings.label_social != blank -%}
                <p class="colophon__label">{{ section.settings.label_social | escape }}</p>
              {%- endif -%}
              <ul class="colophon__col">
                {%- for link in social.links -%}
                  <li>
                    <a href="{{ link.url }}" class="colophon__link colophon__text">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- assign secondary = section.settings.menu_secondary -%}
          {%- if secondary != blank and secondary.links.size > 0 -%}
            <div class="colophon__group colophon__group--secondary">
              {%- if section.settings.label_secondary != blank -%}
                <p class="colophon__label">{{ section.settings.label_secondary | escape }}</p>
              {%- endif -%}
              <ul class="colophon__col">
                {%- for link in secondary.links -%}
                  <li>
                    <a href="{{ link.url }}" class="colophon__link colophon__text">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          Not shop.enabled_payment_types: that returns the gateways Shopify has
          configured and renders them via payment_type_svg_tag as fixed full
          colour brand art, which cannot take the footer's ink and does not cover
          the UPI and Paytm marks the design calls for. The list is a setting so
          a merchant can still match it to what checkout actually offers.
        {%- endcomment -%}
        {%- comment -%}
          The whitelist repeats bf-payment-mark's own case list so a typo in the
          setting drops the item rather than emitting an empty <li> that would
          open a gap in the row.
        {%- endcomment -%}
        {%- assign known_marks = 'visa,mastercard,amex,upi,gpay,paytm' | split: ',' -%}
        {%- assign payment_marks = section.settings.payment_marks | split: ',' -%}
        {%- if payment_marks.size > 0 -%}
          <div class="colophon__group colophon__group--payments">
            {%- if section.settings.label_payments != blank -%}
              <p class="colophon__label">{{ section.settings.label_payments | escape }}</p>
            {%- endif -%}
            <ul class="colophon__payments">
              {%- for payment_mark in payment_marks -%}
                {%- assign mark_key = payment_mark | strip | downcase -%}
                {%- if known_marks contains mark_key -%}
                  <li class="colophon__payment">
                    {%- render 'bf-payment-mark', mark: mark_key -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </footer>
{%- endunless -%}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "info": "Auto follows the design: full on browse and content pages, minimal on cart and legal pages, hidden on 404.",
      "options": [
        { "value": "auto", "label": "Auto (by template)" },
        { "value": "full", "label": "Full" },
        { "value": "minimal", "label": "Minimal" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
      "id": "tagline_line_1",
      "label": "Tagline line 1",
      "default": "Made to be worn."
    },
    {
      "type": "text",
      "id": "tagline_line_2",
      "label": "Tagline line 2",
      "default": "Or raved in. Or both."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "Bassface creates music-inspired apparel that lets you wear your passion. From iconic tracks to legendary DJs, our designs bring the energy of the music to your style."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enabled",
      "label": "Show newsletter signup",
      "info": "Subscribers are tagged \"newsletter\" and appear under Customers.",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "Newsletter label",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_copy",
      "label": "Newsletter copy",
      "default": "Drops, restocks and the occasional bit of noise. No spam."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "you@email.com"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "22/1, Kandappa Street\nSowcarpet, Parktown\nChennai 600001, India"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "info": "The current year is appended automatically.",
      "default": "All rights reserved"
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu_policies",
      "label": "Policy links",
      "info": "Point these at Pages, not /policies/ URLs — Shopify policy pages cannot use this theme's design. Suggested menu: footer-policies."
    },
    {
      "type": "link_list",
      "id": "menu_social",
      "label": "Social links",
      "info": "Suggested menu: footer-social."
    },
    {
      "type": "link_list",
      "id": "menu_secondary",
      "label": "Secondary links",
      "info": "Suggested menu: footer-secondary."
    },
    {
      "type": "header",
      "content": "Column labels",
      "info": "Leave a label blank to hide it. A column is hidden entirely when its menu is unset."
    },
    {
      "type": "text",
      "id": "label_address",
      "label": "Address column",
      "default": "Studio"
    },
    {
      "type": "text",
      "id": "label_policies",
      "label": "Policy column",
      "default": "Legal"
    },
    {
      "type": "text",
      "id": "label_social",
      "label": "Social column",
      "default": "Follow"
    },
    {
      "type": "text",
      "id": "label_secondary",
      "label": "Secondary column",
      "default": "Company"
    },
    {
      "type": "header",
      "content": "Payment marks"
    },
    {
      "type": "text",
      "id": "label_payments",
      "label": "Payments label",
      "default": "We accept"
    },
    {
      "type": "text",
      "id": "payment_marks",
      "label": "Marks to show",
      "info": "Comma-separated, in display order. Available: visa, mastercard, amex, upi, gpay, paytm. Clear the field to hide the row.",
      "default": "visa, mastercard, amex, upi, gpay, paytm"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
