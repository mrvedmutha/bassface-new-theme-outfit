{%- comment -%}
  Preloader — rendered as a static section from layout/theme.liquid, first thing
  inside <body> so it covers the page before anything else can paint.

  Styles live in assets/bf-preloader.css and are pulled in from <head>, where
  being render-blocking is the correct behaviour for a preloader. Colours arrive
  as custom properties set inline below, so that file stays static and cacheable.

  Images come from either a collection's products or six manual uploads — see
  the `image_source` setting.
{%- endcomment -%}

{%- liquid
  assign show = section.settings.enabled

  if section.settings.image_source == 'collection' and section.settings.collection != blank
    assign images = section.settings.collection.products
  endif
-%}

{%- if show -%}
  {%- comment -%}
    Runs as the section parses, before any page content below it can paint, so
    there is no frame where the document is scrollable and uncovered.
  {%- endcomment -%}
  <script>
    document.documentElement.classList.add('is-preloading');
  </script>

  <bf-preloader data-once-per-session="{{ section.settings.once_per_session }}">
    <div
      class="preloader"
      style="--preloader-bg: {{ section.settings.background_color }}; --preloader-mark: {{ section.settings.mark_color }};"
    >
      <div class="preloader__stage">
        <div class="preloader__cards is-hidden">
          {%- if section.settings.image_source == 'collection' -%}
            {%- for product in images limit: 6 -%}
              {%- if product.featured_image -%}
                <img
                  class="preloader__card"
                  src="{{ product.featured_image | image_url: width: 450 }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 300 }} 300w,
                    {{ product.featured_image | image_url: width: 450 }} 450w,
                    {{ product.featured_image | image_url: width: 700 }} 700w
                  "
                  sizes="(min-width: 750px) 12vw, 30vw"
                  width="450"
                  height="600"
                  alt=""
                  fetchpriority="high"
                  decoding="async"
                >
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              {%- assign key = 'image_' | append: i -%}
              {%- assign image = section.settings[key] -%}
              {%- if image != blank -%}
                <img
                  class="preloader__card"
                  src="{{ image | image_url: width: 450 }}"
                  srcset="
                    {{ image | image_url: width: 300 }} 300w,
                    {{ image | image_url: width: 450 }} 450w,
                    {{ image | image_url: width: 700 }} 700w
                  "
                  sizes="(min-width: 750px) 12vw, 30vw"
                  width="450"
                  height="600"
                  alt=""
                  fetchpriority="high"
                  decoding="async"
                >
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="preloader__mark-mask">
          {%- render 'bassface-wordmark', class: 'preloader__mark is-hidden' -%}
        </div>

        <div class="preloader__counter-mask">
          <span class="preloader__counter">000</span>
        </div>
      </div>
    </div>
  </bf-preloader>

  <script src="{{ 'bf-preloader.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Preloader",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable preloader",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "once_per_session",
      "label": "Show only once per session",
      "info": "Off means the animation plays on every page load, which adds ~4.8s before content on every navigation.",
      "default": false
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_source",
      "label": "Image source",
      "options": [
        { "value": "custom", "label": "Custom images" },
        { "value": "collection", "label": "Collection products" }
      ],
      "default": "custom"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Uses the featured image of the first 6 products."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "mark_color",
      "label": "Wordmark and counter",
      "info": "Blends with difference over the images, so it inverts against bright photos.",
      "default": "#EDE4DD"
    }
  ]
}
{% endschema %}
