{%- comment -%}
  One card in the preloader stack.

  Accepts:
    image - an image object (product featured_image or an image_picker setting)

  Rendered through image_url so Shopify generates optimised responsive variants
  rather than serving the original upload.
{%- endcomment -%}
<img
  class="preloader__card"
  src="{{ image | image_url: width: 450 }}"
  srcset="
    {{ image | image_url: width: 300 }} 300w,
    {{ image | image_url: width: 450 }} 450w,
    {{ image | image_url: width: 700 }} 700w
  "
  sizes="(min-width: 750px) 12vw, 30vw"
  width="450"
  height="600"
  alt=""
  fetchpriority="high"
  decoding="async"
>
