{%- comment -%}
  Full-screen mobile navigation drawer.

  Carries `data-bf-invert`, so its surface and ink are the page theme's pair
  swapped — a red page opens a red drawer with cream ink, a light page opens a
  black one, a dark page opens a cream one. No colour is named here.

  Items are Shop · Login · Bag. NOT Search: the mobile bar already carries it,
  and since this drawer covers that bar rather than sitting beside it, the two
  are never on screen together — a visitor sees Search in the bar, opens the
  drawer, and finds it listed again for no reason. It is reachable in one tap
  either way, so the drawer drops it.

  Bag is still repeated, and that is different: the bar's Bag carries the item
  count, which is worth having in front of someone mid-browse and again when
  they open the menu to leave.

  Accepts:
    menu          - a linklist, rendered ahead of the functional items
    address       - store address for the drawer footer
    show_currency - whether to render the currency picker. Passed in rather than
                    re-derived here, so the drawer and the nav cannot disagree
                    about the merchant's setting.

  Usage:
    {%- render 'bf-nav-drawer',
      menu: section.settings.menu,
      address: section.settings.address,
      show_currency: show_currency
    -%}
{%- endcomment -%}

{%- comment -%}
  The count the blocks below the menu key their delay off. Computed here rather
  than counted in CSS, which has no way to ask how many children a list has.
{%- endcomment -%}
{%- liquid
  assign drawer_items = menu.links.size | plus: 1
  if shop.customer_accounts_enabled
    assign drawer_items = drawer_items | plus: 1
  endif
-%}

{%- comment -%}
  data-lenis-prevent hands this element's own scrolling back to the browser.
  Lenis drives the PAGE, and without this it also swallows wheel events over any
  scroller inside it — so a drawer taller than the screen would refuse to move
  while the page behind it did. It is what makes the scroll happen at drawer
  level rather than page level.
{%- endcomment -%}
<bf-nav-drawer
  id="BFNavDrawer"
  class="nav-drawer"
  style="--nav-drawer-count: {{ drawer_items }};"
  data-lenis-prevent
  data-bf-invert
>
  <div class="nav-drawer__top">
    <a class="masthead__logo" href="{{ routes.root_url }}">
      {%- render 'bf-logo', shape: 'mark', width: '44px', label: shop.name -%}
    </a>

    <button type="button" class="nav-drawer__close" data-bf-drawer-close>
      {{ 'Close' }}
    </button>
  </div>

  {%- comment -%}
    `--nav-drawer-index` is what staggers the entrance, and it has to be a
    running count across the whole list rather than forloop.index0: the menu
    links come from a loop but Login and Bag do not, so the loop's counter stops
    two items short and those two would open together with the last link.
  {%- endcomment -%}
  {%- liquid
    assign item_index = 0
  -%}

  <div class="nav-drawer__menu">
    <ul class="nav-drawer__links">
      {%- for link in menu.links -%}
        <li class="nav-drawer__item" style="--nav-drawer-index: {{ item_index }};">
          <a class="nav-drawer__link" href="{{ link.url }}">{{ link.title }}</a>
        </li>
        {%- assign item_index = item_index | plus: 1 -%}
      {%- endfor -%}

      {%- if shop.customer_accounts_enabled -%}
        <li class="nav-drawer__item" style="--nav-drawer-index: {{ item_index }};">
          <a class="nav-drawer__link" href="{{ routes.account_url }}">
            {%- if customer %}{{ 'Account' }}{% else %}{{ 'Login' }}{% endif -%}
          </a>
        </li>
        {%- assign item_index = item_index | plus: 1 -%}
      {%- endif -%}

      <li class="nav-drawer__item" style="--nav-drawer-index: {{ item_index }};">
        <a class="nav-drawer__link" href="{{ routes.cart_url }}">{{- 'Bag' }} ({{ cart.item_count }}) </a>
      </li>
      {%- assign item_index = item_index | plus: 1 -%}
    </ul>

    {%- if show_currency -%}
      {%- comment -%}
        Same control as the nav: a native select laid invisibly over the label,
        so the platform's own picker and keyboard behaviour are kept. The
        `data-bf-currency-select` hook is what submits it — see bf-header.js.
      {%- endcomment -%}
      {%- form 'localization', class: 'nav-drawer__currency' -%}
        <span class="nav-drawer__currency-label">
          {{ cart.currency.symbol }} · {{ cart.currency.iso_code }}
          {%- render 'bf-icon', icon: 'chevron-down', size: 18 -%}

          <select
            class="nav-drawer__currency-select"
            name="country_code"
            data-bf-currency-select
            aria-label="{{ 'localization.country_label' | t }}"
          >
            {%- for country in localization.available_countries -%}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.name }} · {{ country.currency.iso_code }}
              </option>
            {%- endfor -%}
          </select>
        </span>
      {%- endform -%}
    {%- endif -%}

    <div class="nav-drawer__switcher">
      {%- render 'bf-theme-switcher', size: 'lg' -%}
    </div>
  </div>

  <div class="nav-drawer__footer">
    <div class="nav-drawer__brand">
      {%- render 'bf-logo', shape: 'wordmark', width: '150px', label: shop.name -%}
      <p class="nav-drawer__fine">{{- 'All rights reserved' }} &copy; {{ 'now' | date: '%y' -}}</p>
    </div>

    {%- if address != blank -%}
      <p class="nav-drawer__fine nav-drawer__fine--address">{{ address }}</p>
    {%- endif -%}
  </div>
</bf-nav-drawer>
