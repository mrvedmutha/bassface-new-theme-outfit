[
  {
    "name": "theme_info",
    "theme_name": "Dawn",
    "theme_version": "15.5.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Scrolling",
    "settings": [
      {
        "type": "checkbox",
        "id": "smooth_scroll_enabled",
        "label": "Smooth scrolling",
        "info": "Adds momentum to the page scroll on mouse and trackpad. Touch devices keep the platform's own scrolling either way, and it is skipped entirely for visitors who ask for reduced motion.",
        "default": true
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "search_enabled",
        "label": "Enable the search overlay",
        "info": "Off falls back to the plain search page. The header and drawer links keep working either way.",
        "default": true
      },
      {
        "type": "range",
        "id": "search_result_limit",
        "label": "Results shown per type",
        "info": "One row of each. More than this and the show-all button appears \u2014 the overlay always asks Shopify for ten so it can tell there are more.",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4
      },
      {
        "type": "text",
        "id": "search_placeholder",
        "label": "Placeholder",
        "default": "Search for products, artists, collections…"
      },
      {
        "type": "text",
        "id": "search_all_label",
        "label": "Show-all button",
        "info": "Appears only when the results are taller than the screen.",
        "default": "Show All Results"
      },
      {
        "type": "text",
        "id": "search_products_heading",
        "label": "Products heading",
        "info": "Shown above the product results.",
        "default": "Products"
      },
      {
        "type": "header",
        "content": "Before anything is typed"
      },
      {
        "type": "collection",
        "id": "search_popular_collection",
        "label": "Popular products",
        "info": "The first four are shown on tablet and desktop. Leave empty to use all products. Hidden on phones, where collections fill the screen instead."
      },
      {
        "type": "text",
        "id": "search_popular_heading",
        "label": "Popular heading",
        "default": "Popular"
      },
      {
        "type": "text",
        "id": "search_collections_heading",
        "label": "Collections heading",
        "default": "Collections"
      }
    ]
  },
  {
    "name": "Cursor",
    "settings": [
      {
        "type": "checkbox",
        "id": "cursor_enabled",
        "label": "Enable trailing cursor",
        "info": "A dot follows the pointer and grows into a labelled disc over product cards. Shown only on devices with a mouse or trackpad; phones and tablets are unaffected.",
        "default": true
      },
      {
        "type": "text",
        "id": "cursor_label",
        "label": "Label over product cards",
        "info": "Shown in uppercase. Keep it to two or three words — it has to fit inside the disc on one line.",
        "default": "View More"
      }
    ]
  },
  {
    "name": "Preloader",
    "settings": [
      {
        "type": "checkbox",
        "id": "preloader_enabled",
        "label": "Enable preloader",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "preloader_once_per_session",
        "label": "Show only once per session",
        "info": "Off means the animation plays on every page load, adding ~4.8s before content on every navigation.",
        "default": false
      },
      {
        "type": "header",
        "content": "Images"
      },
      {
        "type": "select",
        "id": "preloader_image_source",
        "label": "Image source",
        "options": [
          {
            "value": "custom",
            "label": "Custom images"
          },
          {
            "value": "collection",
            "label": "Collection products"
          }
        ],
        "default": "custom"
      },
      {
        "type": "collection",
        "id": "preloader_collection",
        "label": "Collection",
        "info": "Uses the featured image of the first 6 products."
      },
      {
        "type": "paragraph",
        "content": "Up to 6 images. Empty slots are skipped. Portrait 9:12 works best — around 900x1200."
      },
      {
        "type": "image_picker",
        "id": "preloader_image_1",
        "label": "Image 1"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_2",
        "label": "Image 2"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_3",
        "label": "Image 3"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_4",
        "label": "Image 4"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_5",
        "label": "Image 5"
      },
      {
        "type": "image_picker",
        "id": "preloader_image_6",
        "label": "Image 6"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "preloader_background_color",
        "label": "Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "preloader_mark_color",
        "label": "Wordmark and counter",
        "info": "Blends with difference over the images, so it inverts against bright photos.",
        "default": "#EDE4DD"
      }
    ]
  },
  {
    "name": "Page transitions",
    "settings": [
      {
        "type": "checkbox",
        "id": "page_transition_enabled",
        "label": "Enable page transitions",
        "info": "Links load in place behind a wipe instead of reloading the browser. The full preloader then plays only on a hard load or refresh.",
        "default": true
      },
      {
        "type": "paragraph",
        "content": "Checkout, account and app pages always load normally. Turning this off restores standard browser navigation everywhere."
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "color",
        "id": "page_transition_background_color",
        "label": "Panel",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "page_transition_mark_color",
        "label": "Wordmark",
        "default": "#EDE4DD"
      }
    ]
  },
