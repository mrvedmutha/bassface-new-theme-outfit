{
  "name": "bassface-new-theme-outfit",
  "version": "1.0.0",
  "private": true,
  "description": "Bassface storefront — Dawn 15.5 theme, OUTFIT-inspired redesign",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:liquid && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:liquid": "shopify theme check --path .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "eslint . --fix && stylelint \"**/*.css\" --fix && prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.liquid": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-selector-bem-pattern": "^5.0.0"
  }
}
